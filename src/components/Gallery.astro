---
import { ArrowLeft, ArrowRight, ArrowUpRight, X } from '@lucide/astro';
import { designs } from '../data/designs';
import { getWhatsAppPhone, getWhatsAppUrl, whatsappMessages } from '../data/business';

const bookingUrl = getWhatsAppUrl(whatsappMessages.general);
const designPayload = designs.map(({ name, image, imageAlt, description, width, height }) => ({
  name,
  image,
  imageAlt,
  description,
  width,
  height,
  whatsappMessage: whatsappMessages.forDesign(name),
}));
---

<section class="section gallery-section" id="disenos" aria-labelledby="gallery-title">
  <div class="section-heading gallery-heading">
    <div>
      <p class="eyebrow"><span class="eyebrow-line"></span> Trabajos de Valeria</p>
      <h2 id="gallery-title">Ideas para tus uñas,<br /><em>hechas con detalle.</em></h2>
    </div>
    <p class="section-aside">Explora la galería y abre cualquier fotografía para verla ampliada. Cada imagen conserva sus proporciones originales.</p>
  </div>
  <div class="gallery-toolbar">
    <span class="gallery-count">{designs.length} FOTOGRAFÍAS</span>
    <span class="gallery-count gallery-hint">Selecciona una imagen para ampliar</span>
  </div>
  <div class="gallery-grid">
    {designs.map((design, index) => (
      <button
        class="design-card"
        type="button"
        data-design-index={index}
        aria-label={`Ampliar ${design.name}. ${design.imageAlt}`}
      >
        <span class="design-image-wrap">
          <img
            src={design.thumbnail}
            srcset={`${design.thumbnail} 480w, ${design.image} ${design.width}w`}
            sizes="(max-width: 680px) 46vw, (max-width: 900px) 30vw, 370px"
            alt={design.imageAlt}
            width={design.width}
            height={design.height}
            loading="lazy"
            decoding="async"
          />
          <span class="design-open"><ArrowUpRight size={18} /></span>
        </span>
        <span class="design-caption"><span>{design.name}</span></span>
      </button>
    ))}
  </div>

  <dialog class="lightbox" aria-label="Vista ampliada de la fotografía" aria-modal="true">
    <button class="lightbox-close" type="button" aria-label="Cerrar vista ampliada"><X size={22} /></button>
    <div class="lightbox-image-wrap">
      <img class="lightbox-image" alt="" />
      <button class="lightbox-arrow lightbox-prev" type="button" aria-label="Fotografía anterior"><ArrowLeft size={20} /></button>
      <button class="lightbox-arrow lightbox-next" type="button" aria-label="Siguiente fotografía"><ArrowRight size={20} /></button>
    </div>
    <div class="lightbox-info">
      <h3 class="lightbox-title"></h3>
      <p class="lightbox-description"></p>
      {bookingUrl && <a class="button button-dark lightbox-cta" href={bookingUrl} target="_blank" rel="noreferrer">
        Consultar por este diseño <ArrowUpRight size={16} />
      </a>}
    </div>
  </dialog>
</section>

<script define:vars={{ designPayload, whatsappPhone: getWhatsAppPhone() }}>
  const cards = [...document.querySelectorAll('.design-card')];
  const dialog = document.querySelector('.lightbox');
  const image = document.querySelector('.lightbox-image');
  const title = document.querySelector('.lightbox-title');
  const description = document.querySelector('.lightbox-description');
  const cta = document.querySelector('.lightbox-cta');
  let activeIndex = 0;
  let opener = null;
  let scrollY = 0;
  let bodyStyles = null;

  function lockPageScroll() {
    scrollY = window.scrollY;
    bodyStyles = {
      position: document.body.style.position,
      top: document.body.style.top,
      left: document.body.style.left,
      right: document.body.style.right,
      width: document.body.style.width,
    };
    document.body.classList.add('lightbox-open');
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
  }

  function unlockPageScroll() {
    if (!bodyStyles) return;
    document.body.classList.remove('lightbox-open');
    Object.assign(document.body.style, bodyStyles);
    bodyStyles = null;
    window.scrollTo(0, scrollY);
    opener?.focus({ preventScroll: true });
    opener = null;
  }

  function showDesign(index) {
    if (!designPayload.length) return;
    activeIndex = (index + designPayload.length) % designPayload.length;
    const design = designPayload[activeIndex];
    if (!image || !title || !description || !dialog) return;
    image.src = design.image;
    image.alt = design.imageAlt;
    image.width = design.width;
    image.height = design.height;
    title.textContent = design.name;
    description.textContent = design.description;
    if (cta && whatsappPhone) {
      cta.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(design.whatsappMessage)}`;
      cta.setAttribute('aria-label', `Consultar por WhatsApp sobre ${design.name}`);
    }
    if (!dialog.open) {
      opener = document.activeElement;
      lockPageScroll();
      dialog.showModal();
    }
  }

  cards.forEach((card) => card.addEventListener('click', () => showDesign(Number(card.dataset.designIndex))));
  document.querySelector('.lightbox-close')?.addEventListener('click', () => dialog?.close());
  document.querySelector('.lightbox-prev')?.addEventListener('click', () => showDesign(activeIndex - 1));
  document.querySelector('.lightbox-next')?.addEventListener('click', () => showDesign(activeIndex + 1));
  dialog?.addEventListener('close', unlockPageScroll);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;
    if (event.key === 'Escape') {
      dialog.close();
      return;
    }
    if (event.target instanceof HTMLElement && ['INPUT', 'TEXTAREA', 'SELECT'].includes(event.target.tagName)) return;
    if (event.key === 'ArrowRight') showDesign(activeIndex + 1);
    if (event.key === 'ArrowLeft') showDesign(activeIndex - 1);
  });
</script>
